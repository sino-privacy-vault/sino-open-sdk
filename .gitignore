# Gradle and Kotlin
.gradle/
build/
.kotlin/
local.properties

# IDEs
.idea/
*.iml
.vscode/

# OS and logs
.DS_Store
Thumbs.db
*.log
*.hprof

# Recovery material: never commit a real vault, phrase or recovered files.
# A downloaded vault or recovery run in the repository folder stays out of git.
/SinoVault/
/recovered/
/Recovered/
*.phrase
phrase.txt
*.sino-partial
*.sino-staged
# The interop test fixture is a generated test vault with a test phrase (see its README).
!src/test/resources/fixtures/core-vault/**

# Keys and credentials
*.jks
*.keystore
*.pem
*.p12
